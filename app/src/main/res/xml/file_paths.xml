<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cache directory untuk temporary file PDF yang mau di-share -->
    <cache-path
        name="cache_files"
        path="." />

    <!-- External cache directory -->
    <external-cache-path
        name="external_cache_files"
        path="." />

    <!-- Files directory -->
    <files-path
        name="internal_files"
        path="." />

    <!-- External Files directory untuk PDF -->
    <external-files-path
        name="external_pdf_files"
        path="Documents" />
</paths>
